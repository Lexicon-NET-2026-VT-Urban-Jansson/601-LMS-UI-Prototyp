@page "/login"
@layout LoginLayout
@inject NavigationManager NavigationManager
@inject AuthState AuthState
@using TestClaudeLMS01.Client.Services
@using TestClaudeLMS01.Client.Layout

<PageTitle>Logga in</PageTitle>

<style>
    .login-bg {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        position: relative;
        overflow: hidden;
    }

    .login-card-wrapper {
        position: relative;
        z-index: 10;
        width: 100%;
        max-width: 400px;
        padding: 20px;
    }

    .login-icons {
        position: absolute;
        top: 20px;
        right: 30px;
        font-size: 60px;
        opacity: 0.15;
        z-index: 0;
    }

    .login-icons-bottom {
        position: absolute;
        bottom: 30px;
        left: 20px;
        font-size: 50px;
        opacity: 0.15;
        z-index: 0;
    }
</style>

<div class="login-bg">
    <div class="login-icons">📚</div>
    <div class="login-icons-bottom">✏️</div>
    <div class="login-card-wrapper">
        <RadzenCard style="width: 100%; padding: 40px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); border-radius: 12px;">
        <div style="text-align: center; margin-bottom: 30px;">
            <RadzenIcon Icon="menu_book" style="font-size: 48px; color: var(--rz-primary);" />
            <RadzenText Text="Lexicon LMS" TextStyle="Radzen.Blazor.TextStyle.DisplayH5" TagName="Radzen.Blazor.TagName.H1" style="margin: 15px 0 0 0;" />
        </div>

        <RadzenStack Gap="1.5rem">
            <div>
                <RadzenLabel Text="E-postadress" />
                <RadzenTextBox @bind-Value="@email" Placeholder="demo@lms.test" Style="width: 100%; margin-top: 5px;" />
            </div>

            <div>
                <RadzenLabel Text="Lösenord" />
                <RadzenPassword @bind-Value="@password" Placeholder="Lösenord" Style="width: 100%; margin-top: 5px;" />
            </div>

            <div>
                <RadzenLabel Text="Välj roll (för demo)" style="display: block; margin-bottom: 10px;" />
                <RadzenRadioButtonList @bind-Value="@selectedRole" TValue="UserRole">
                    <Items>
                        <RadzenRadioButtonListItem Text="Elev" Value="UserRole.Elev" />
                        <RadzenRadioButtonListItem Text="Lärare" Value="UserRole.Larare" />
                    </Items>
                </RadzenRadioButtonList>
            </div>

            <RadzenButton Text="Logga in" Click="@OnLogin" ButtonStyle="ButtonStyle.Primary" Style="width: 100%;" />

            <RadzenLink Text="Glömt lösenord?" Path="#" />
        </RadzenStack>
        </RadzenCard>
    </div>
</div>

@code {
    private string email = "demo@lms.test";
    private string password = "";
    private UserRole selectedRole = UserRole.Elev;

    private void OnLogin()
    {
        // Demo: bara välj roll och spara
        AuthState.Login(selectedRole);
        NavigationManager.NavigateTo("/");
    }
}
