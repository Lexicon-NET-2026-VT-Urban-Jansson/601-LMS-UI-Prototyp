@page "/kurser"
@inject MockDataService MockDataService
@using TestClaudeLMS01.Client.Services

<PageTitle>Kurser</PageTitle>

<RadzenStack Gap="2rem">
    <!-- Rubrik -->
    <div>
        <RadzenText Text="Mina kurser" TextStyle="Radzen.Blazor.TextStyle.DisplayH4" />
        <RadzenText Text="Hantera och övervaka dina aktiva kurser" TextStyle="Radzen.Blazor.TextStyle.Body2" style="color: var(--rz-text-secondary-color); margin-top: 5px;" />
    </div>

    <!-- Statistik -->
    <RadzenRow Gap="2rem" RowGap="1rem">
        <RadzenColumn Size="12" SizeMD="3">
            <RadzenCard Style="padding: 15px; text-align: center; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                <RadzenText Text="@Courses.Count.ToString()" TextStyle="Radzen.Blazor.TextStyle.H4" style="margin: 0; color: white;" />
                <RadzenText Text="Aktiva kurser" TextStyle="Radzen.Blazor.TextStyle.Caption" style="color: rgba(255,255,255,0.9);" />
            </RadzenCard>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="3">
            <RadzenCard Style="padding: 15px; text-align: center; background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white;">
                <RadzenText Text="@Courses.Sum(c => c.StudentCount).ToString()" TextStyle="Radzen.Blazor.TextStyle.H4" style="margin: 0; color: white;" />
                <RadzenText Text="Registrerade elever" TextStyle="Radzen.Blazor.TextStyle.Caption" style="color: rgba(255,255,255,0.9);" />
            </RadzenCard>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="3">
            <RadzenCard Style="padding: 15px; text-align: center; background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white;">
                <RadzenText Text="@Courses.Sum(c => c.Modules.Count).ToString()" TextStyle="Radzen.Blazor.TextStyle.H4" style="margin: 0; color: white;" />
                <RadzenText Text="Moduler totalt" TextStyle="Radzen.Blazor.TextStyle.Caption" style="color: rgba(255,255,255,0.9);" />
            </RadzenCard>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="3">
            <RadzenCard Style="padding: 15px; text-align: center; background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); color: white;">
                <RadzenText Text="@Courses.Count(c => c.StartDate <= DateTime.Now && c.EndDate >= DateTime.Now).ToString()" TextStyle="Radzen.Blazor.TextStyle.H4" style="margin: 0; color: white;" />
                <RadzenText Text="Pågående" TextStyle="Radzen.Blazor.TextStyle.Caption" style="color: rgba(255,255,255,0.9);" />
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>

    <!-- Kurs-kort -->
    <div>
        <RadzenText Text="Dina kurser" TextStyle="Radzen.Blazor.TextStyle.H5" style="margin-bottom: 15px;" />
        <RadzenRow Gap="2rem" RowGap="2rem">
            @foreach (var course in Courses)
            {
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenCard Style="padding: 20px; height: 100%; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 8px 16px rgba(0,0,0,0.1)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 1px 3px rgba(0,0,0,0.06)';">
                        <RadzenStack Gap="1rem">
                            <!-- Kurs-rubrik -->
                            <div>
                                <RadzenText Text="@course.Name" TextStyle="Radzen.Blazor.TextStyle.H6" style="margin-bottom: 4px;" />
                                <RadzenText Text="@course.Code" TextStyle="Radzen.Blazor.TextStyle.Body2" style="color: var(--rz-text-secondary-color);" />
                            </div>

                            <!-- Mini-stats -->
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="6">
                                    <div style="text-align: center; padding: 12px; background: linear-gradient(135deg, rgba(102,126,234,0.1) 0%, rgba(118,75,162,0.1) 100%); border-radius: 8px;">
                                        <RadzenText Text="@course.StudentCount.ToString()" TextStyle="Radzen.Blazor.TextStyle.H6" style="margin: 0; color: #667eea; font-weight: 600;" />
                                        <RadzenText Text="elever" TextStyle="Radzen.Blazor.TextStyle.Caption" />
                                    </div>
                                </RadzenColumn>
                                <RadzenColumn Size="6">
                                    <div style="text-align: center; padding: 12px; background: linear-gradient(135deg, rgba(240,147,251,0.1) 0%, rgba(245,87,108,0.1) 100%); border-radius: 8px;">
                                        <RadzenText Text="@course.Modules.Count.ToString()" TextStyle="Radzen.Blazor.TextStyle.H6" style="margin: 0; color: #f5576c; font-weight: 600;" />
                                        <RadzenText Text="moduler" TextStyle="Radzen.Blazor.TextStyle.Caption" />
                                    </div>
                                </RadzenColumn>
                            </RadzenRow>

                            <!-- Datum -->
                            <div style="display: flex; align-items: center; gap: 6px; padding-top: 8px; border-top: 1px solid var(--rz-border-color);">
                                <RadzenIcon Icon="calendar_today" style="font-size: 14px; color: var(--rz-text-secondary-color);" />
                                <RadzenText Text="@($"{course.StartDate:dd MMM} – {course.EndDate:dd MMM}")" TextStyle="Radzen.Blazor.TextStyle.Caption" style="color: var(--rz-text-secondary-color);" />
                            </div>

                            <!-- Status badge -->
                            <div>
                                @{
                                    var now = DateTime.Now;
                                    string statusText = "";
                                    string statusStyle = "";
                                    if (course.StartDate > now)
                                    {
                                        statusText = "Kommande";
                                        statusStyle = "background-color: #2196f3; color: white;";
                                    }
                                    else if (course.EndDate < now)
                                    {
                                        statusText = "Avslutad";
                                        statusStyle = "background-color: #9e9e9e; color: white;";
                                    }
                                    else
                                    {
                                        statusText = "Pågående";
                                        statusStyle = "background-color: #4caf50; color: white;";
                                    }
                                    <RadzenBadge Text="@statusText" style="@statusStyle" />
                                }
                            </div>

                            <!-- Länk -->
                            <RadzenLink Text="Visa detaljer →" Path="@($"/kurser/{course.Id}")" style="font-size: 13px; font-weight: 500;" />
                        </RadzenStack>
                    </RadzenCard>
                </RadzenColumn>
            }
        </RadzenRow>
    </div>
</RadzenStack>

@code {
    private List<Course> Courses;

    protected override void OnInitialized()
    {
        Courses = MockDataService.GetCourses();
    }
}
