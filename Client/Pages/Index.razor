@page "/"
@inject AuthState AuthState
@inject MockDataService MockDataService
@using TestClaudeLMS01.Client.Services
@using TestClaudeLMS01.Client.Layout

<PageTitle>Dashboard</PageTitle>

@if (!AuthState.IsAuthenticated)
{
    <p>Du är inte inloggad.</p>
}
else if (AuthState.CurrentRole == UserRole.Elev)
{
    <!-- ELEV DASHBOARD -->
    <RadzenStack Gap="2rem">
        <!-- Välkommen -->
        <div>
            <RadzenText Text="Välkommen tillbaka, Anna!" TextStyle="Radzen.Blazor.TextStyle.DisplayH4" />
            <RadzenText Text="Frontend-utvecklare" TextStyle="Radzen.Blazor.TextStyle.Body2" style="color: var(--rz-text-secondary-color); margin-top: 5px;" />
        </div>

        <!-- Statistik-sammanfattning -->
        <RadzenRow Gap="2rem" RowGap="1rem">
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenCard Style="padding: 20px; text-align: center; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 4px 12px rgba(102,126,234,0.3);" onmouseover="this.style.transform='translateY(-6px) scale(1.02)'; this.style.boxShadow='0 12px 24px rgba(102,126,234,0.5)';" onmouseout="this.style.transform='translateY(0) scale(1)'; this.style.boxShadow='0 4px 12px rgba(102,126,234,0.3)';">
                    <RadzenIcon Icon="trending_up" style="font-size: 32px; margin-bottom: 8px; display: block;" />
                    <RadzenText Text="67%" TextStyle="Radzen.Blazor.TextStyle.H4" style="margin: 0; color: white;" />
                    <RadzenText Text="Kursframsteg" TextStyle="Radzen.Blazor.TextStyle.Caption" style="color: rgba(255,255,255,0.9);" />
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenCard Style="padding: 20px; text-align: center; background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 4px 12px rgba(245,87,108,0.3);" onmouseover="this.style.transform='translateY(-6px) scale(1.02)'; this.style.boxShadow='0 12px 24px rgba(245,87,108,0.5)';" onmouseout="this.style.transform='translateY(0) scale(1)'; this.style.boxShadow='0 4px 12px rgba(245,87,108,0.3)';">
                    <RadzenIcon Icon="assignment" style="font-size: 32px; margin-bottom: 8px; display: block;" />
                    <RadzenText Text="2" TextStyle="Radzen.Blazor.TextStyle.H4" style="margin: 0; color: white;" />
                    <RadzenText Text="Väntar på inlämning" TextStyle="Radzen.Blazor.TextStyle.Caption" style="color: rgba(255,255,255,0.9);" />
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenCard Style="padding: 20px; text-align: center; background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 4px 12px rgba(79,172,254,0.3);" onmouseover="this.style.transform='translateY(-6px) scale(1.02)'; this.style.boxShadow='0 12px 24px rgba(79,172,254,0.5)';" onmouseout="this.style.transform='translateY(0) scale(1)'; this.style.boxShadow='0 4px 12px rgba(79,172,254,0.3)';">
                    <RadzenIcon Icon="feedback" style="font-size: 32px; margin-bottom: 8px; display: block;" />
                    <RadzenText Text="1" TextStyle="Radzen.Blazor.TextStyle.H4" style="margin: 0; color: white;" />
                    <RadzenText Text="Feedback väntar" TextStyle="Radzen.Blazor.TextStyle.Caption" style="color: rgba(255,255,255,0.9);" />
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenCard Style="padding: 20px; text-align: center; background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); color: white; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 4px 12px rgba(67,233,123,0.3);" onmouseover="this.style.transform='translateY(-6px) scale(1.02)'; this.style.boxShadow='0 12px 24px rgba(67,233,123,0.5)';" onmouseout="this.style.transform='translateY(0) scale(1)'; this.style.boxShadow='0 4px 12px rgba(67,233,123,0.3)';">
                    <RadzenIcon Icon="school" style="font-size: 32px; margin-bottom: 8px; display: block;" />
                    <RadzenText Text="1/3" TextStyle="Radzen.Blazor.TextStyle.H4" style="margin: 0; color: white;" />
                    <RadzenText Text="Moduler klara" TextStyle="Radzen.Blazor.TextStyle.Caption" style="color: rgba(255,255,255,0.9);" />
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Gap="2rem" RowGap="2rem">
            <!-- Denna vecka -->
            <RadzenColumn Size="12" SizeMD="8">
                <RadzenCard Style="padding: 20px;">
                    <RadzenText Text="Denna vecka" TextStyle="Radzen.Blazor.TextStyle.H5" style="margin-bottom: 15px;" />
                    <RadzenDataGrid Data="@ElevActivities" ColumnWidth="100%" AllowPaging="false">
                        <Columns>
                            <RadzenDataGridColumn Property="Date" Title="Datum" Width="100px" FormatString="{0:yyyy-MM-dd}" />
                            <RadzenDataGridColumn Property="Name" Title="Aktivitet" />
                            <RadzenDataGridColumn Property="Type" Title="Typ" Width="120px" />
                        </Columns>
                    </RadzenDataGrid>
                </RadzenCard>
            </RadzenColumn>

            <!-- Inlämningar - Förbättrad -->
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard Style="padding: 20px; height: 100%;">
                    <RadzenText Text="Inlämningar" TextStyle="Radzen.Blazor.TextStyle.H5" style="margin-bottom: 15px;" />
                    <RadzenStack Gap="1.2rem">
                        @foreach (var a in ElevAssignments)
                        {
                            <div style="padding: 15px; border: 1px solid var(--rz-border-color); border-radius: 8px; background-color: var(--rz-body-background-color);">
                                <RadzenStack Gap="0.8rem">
                                    <!-- Titel + Status -->
                                    <div style="display: flex; justify-content: space-between; align-items: start;">
                                        <RadzenText Text="@a.Name" TextStyle="Radzen.Blazor.TextStyle.Body2" style="font-weight: 500;" />
                                        <RadzenBadge Text="@a.Status" style="@GetBadgeStyle(a.Status)" />
                                    </div>

                                    <!-- Deadline -->
                                    <div style="display: flex; align-items: center; gap: 6px;">
                                        <RadzenIcon Icon="calendar_today" style="font-size: 14px; color: var(--rz-text-secondary-color);" />
                                        <RadzenText Text="@($"{a.Deadline:yyyy-MM-dd}")" TextStyle="Radzen.Blazor.TextStyle.Caption" style="color: var(--rz-text-secondary-color);" />
                                    </div>

                                    <!-- Betyg/Feedback -->
                                    @if (a.Grade.HasValue)
                                    {
                                        <div style="display: flex; align-items: center; gap: 6px; color: #4caf50;">
                                            <RadzenIcon Icon="check_circle" style="font-size: 14px;" />
                                            <RadzenText Text="@($"Betyg: {a.Grade}%")" TextStyle="Radzen.Blazor.TextStyle.Caption" style="color: #4caf50;" />
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(a.Feedback))
                                    {
                                        <div style="background-color: #e8f5e9; padding: 8px; border-radius: 4px; border-left: 3px solid #4caf50;">
                                            <RadzenText Text="@($"💬 {a.Feedback}")" TextStyle="Radzen.Blazor.TextStyle.Caption" style="color: #2e7d32;" />
                                        </div>
                                    }
                                </RadzenStack>
                            </div>
                        }
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>
    </RadzenStack>
}
else
{
    <!-- LÄRARE DASHBOARD -->
    <RadzenStack Gap="2rem">
        <!-- Rubrik -->
        <div>
            <RadzenText Text="Lärardashboard" TextStyle="Radzen.Blazor.TextStyle.DisplayH4" />
            <RadzenText Text="Hantera dina kurser, moduler och studenter" TextStyle="Radzen.Blazor.TextStyle.Body2" style="color: var(--rz-text-secondary-color); margin-top: 5px;" />
        </div>

        <!-- Statistik-sammanfattning -->
        <RadzenRow Gap="2rem" RowGap="1rem">
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenCard Style="padding: 20px; text-align: center; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 4px 12px rgba(102,126,234,0.3);" onmouseover="this.style.transform='translateY(-6px) scale(1.02)'; this.style.boxShadow='0 12px 24px rgba(102,126,234,0.5)';" onmouseout="this.style.transform='translateY(0) scale(1)'; this.style.boxShadow='0 4px 12px rgba(102,126,234,0.3)';">
                    <RadzenIcon Icon="menu_book" style="font-size: 32px; margin-bottom: 8px; display: block;" />
                    <RadzenText Text="@LarrareCourses.Count.ToString()" TextStyle="Radzen.Blazor.TextStyle.H4" style="margin: 0; color: white;" />
                    <RadzenText Text="Aktiva kurser" TextStyle="Radzen.Blazor.TextStyle.Caption" style="color: rgba(255,255,255,0.9);" />
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenCard Style="padding: 20px; text-align: center; background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 4px 12px rgba(245,87,108,0.3);" onmouseover="this.style.transform='translateY(-6px) scale(1.02)'; this.style.boxShadow='0 12px 24px rgba(245,87,108,0.5)';" onmouseout="this.style.transform='translateY(0) scale(1)'; this.style.boxShadow='0 4px 12px rgba(245,87,108,0.3)';">
                    <RadzenIcon Icon="group" style="font-size: 32px; margin-bottom: 8px; display: block;" />
                    <RadzenText Text="@LarrareCourses.Sum(c => c.StudentCount).ToString()" TextStyle="Radzen.Blazor.TextStyle.H4" style="margin: 0; color: white;" />
                    <RadzenText Text="Registrerade elever" TextStyle="Radzen.Blazor.TextStyle.Caption" style="color: rgba(255,255,255,0.9);" />
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenCard Style="padding: 20px; text-align: center; background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 4px 12px rgba(79,172,254,0.3);" onmouseover="this.style.transform='translateY(-6px) scale(1.02)'; this.style.boxShadow='0 12px 24px rgba(79,172,254,0.5)';" onmouseout="this.style.transform='translateY(0) scale(1)'; this.style.boxShadow='0 4px 12px rgba(79,172,254,0.3)';">
                    <RadzenIcon Icon="layers" style="font-size: 32px; margin-bottom: 8px; display: block;" />
                    <RadzenText Text="@LarrareCourses.Sum(c => c.Modules.Count).ToString()" TextStyle="Radzen.Blazor.TextStyle.H4" style="margin: 0; color: white;" />
                    <RadzenText Text="Totala moduler" TextStyle="Radzen.Blazor.TextStyle.Caption" style="color: rgba(255,255,255,0.9);" />
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenCard Style="padding: 20px; text-align: center; background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); color: white; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 4px 12px rgba(67,233,123,0.3);" onmouseover="this.style.transform='translateY(-6px) scale(1.02)'; this.style.boxShadow='0 12px 24px rgba(67,233,123,0.5)';" onmouseout="this.style.transform='translateY(0) scale(1)'; this.style.boxShadow='0 4px 12px rgba(67,233,123,0.3)';">
                    <RadzenIcon Icon="done_all" style="font-size: 32px; margin-bottom: 8px; display: block;" />
                    <RadzenText Text="12" TextStyle="Radzen.Blazor.TextStyle.H4" style="margin: 0; color: white;" />
                    <RadzenText Text="Väntar på feedback" TextStyle="Radzen.Blazor.TextStyle.Caption" style="color: rgba(255,255,255,0.9);" />
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>

        <!-- Snabbåtgärder -->
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem">
            <RadzenButton Text="➕ Skapa ny kurs" Icon="add_circle_outline" ButtonStyle="ButtonStyle.Primary" />
            <RadzenButton Text="👤 Lägg till användare" Icon="person_add" ButtonStyle="ButtonStyle.Secondary" />
        </RadzenStack>

        <!-- Dina aktiva kurser -->
        <div>
            <RadzenText Text="Dina aktiva kurser" TextStyle="Radzen.Blazor.TextStyle.H5" style="margin-bottom: 15px;" />
            <RadzenRow Gap="2rem" RowGap="2rem">
                @foreach (var course in LarrareCourses)
                {
                    <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                        <RadzenCard Style="padding: 20px; height: 100%; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 8px 16px rgba(0,0,0,0.1)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 1px 3px rgba(0,0,0,0.06)';">
                            <RadzenStack Gap="1rem">
                                <!-- Kurs-titel -->
                                <div>
                                    <RadzenText Text="@course.Name" TextStyle="Radzen.Blazor.TextStyle.H6" style="margin-bottom: 4px;" />
                                    <RadzenText Text="@course.Code" TextStyle="Radzen.Blazor.TextStyle.Body2" style="color: var(--rz-text-secondary-color);" />
                                </div>

                                <!-- Mini-statistik -->
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="6">
                                        <div style="text-align: center; padding: 12px; background: linear-gradient(135deg, rgba(102,126,234,0.1) 0%, rgba(118,75,162,0.1) 100%); border-radius: 8px;">
                                            <RadzenText Text="@course.StudentCount.ToString()" TextStyle="Radzen.Blazor.TextStyle.H6" style="margin: 0; color: #667eea; font-weight: 600;" />
                                            <RadzenText Text="elever" TextStyle="Radzen.Blazor.TextStyle.Caption" />
                                        </div>
                                    </RadzenColumn>
                                    <RadzenColumn Size="6">
                                        <div style="text-align: center; padding: 12px; background: linear-gradient(135deg, rgba(240,147,251,0.1) 0%, rgba(245,87,108,0.1) 100%); border-radius: 8px;">
                                            <RadzenText Text="@course.Modules.Count.ToString()" TextStyle="Radzen.Blazor.TextStyle.H6" style="margin: 0; color: #f5576c; font-weight: 600;" />
                                            <RadzenText Text="moduler" TextStyle="Radzen.Blazor.TextStyle.Caption" />
                                        </div>
                                    </RadzenColumn>
                                </RadzenRow>

                                <!-- Datum-info -->
                                <div style="display: flex; align-items: center; gap: 6px; padding-top: 8px; border-top: 1px solid var(--rz-border-color);">
                                    <RadzenIcon Icon="calendar_today" style="font-size: 14px; color: var(--rz-text-secondary-color);" />
                                    <RadzenText Text="@($"{course.StartDate:MMM dd} - {course.EndDate:MMM dd}")" TextStyle="Radzen.Blazor.TextStyle.Caption" style="color: var(--rz-text-secondary-color);" />
                                </div>

                                <!-- Länk -->
                                <RadzenLink Text="Gå till kurs →" Path="@($"/kurser/{course.Id}")" style="font-size: 13px; font-weight: 500;" />
                            </RadzenStack>
                        </RadzenCard>
                    </RadzenColumn>
                }
            </RadzenRow>
        </div>

        <!-- Senaste aktiviteter -->
        <RadzenCard Style="padding: 20px;">
            <RadzenText Text="📋 Senaste aktiviteter" TextStyle="Radzen.Blazor.TextStyle.H5" style="margin-bottom: 15px;" />
            <RadzenStack Gap="1.2rem">
                @foreach (var activity in LarareActivities)
                {
                    <div style="padding: 14px; border-left: 4px solid var(--rz-primary); background: linear-gradient(90deg, rgba(102,126,234,0.05) 0%, transparent 100%); border-radius: 4px;">
                        <RadzenStack Gap="0.4rem">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <RadzenIcon Icon="circle" style="font-size: 10px; color: var(--rz-primary);" />
                                <RadzenText Text="@activity.Name" TextStyle="Radzen.Blazor.TextStyle.Body2" style="font-weight: 500;" />
                            </div>
                            <RadzenText Text="@($"{activity.Date:yyyy-MM-dd HH:mm} — {activity.Description}")" TextStyle="Radzen.Blazor.TextStyle.Caption" style="color: var(--rz-text-secondary-color); margin-left: 18px;" />
                        </RadzenStack>
                    </div>
                }
            </RadzenStack>
        </RadzenCard>
    </RadzenStack>
}

@code {
    private List<Activity> ElevActivities;
    private List<Assignment> ElevAssignments;
    private List<Course> LarrareCourses;
    private List<Activity> LarareActivities;

    protected override void OnInitialized()
    {
        if (AuthState.IsAuthenticated && AuthState.CurrentRole == UserRole.Elev)
        {
            var course = MockDataService.GetCourse(1);
            ElevActivities = course.Modules.SelectMany(m => m.Activities).ToList();
            ElevAssignments = MockDataService.GetAssignmentsForStudent(1);
        }
        else if (AuthState.IsAuthenticated)
        {
            LarrareCourses = MockDataService.GetCourses();
            LarareActivities = MockDataService.GetRecentActivities();
        }
    }

    private string GetBadgeStyle(string status)
    {
        return status switch
        {
            "Inlämnad" => "background-color: #4caf50; color: white;",
            "Ej inlämnad" => "background-color: #ff9800; color: white;",
            "Försenad" => "background-color: #f44336; color: white;",
            "Returnerad" => "background-color: #2196f3; color: white;",
            _ => "background-color: #9e9e9e; color: white;"
        };
    }
}
